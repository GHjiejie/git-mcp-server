{
  "name": "git-mcp-server",
  "version": "1.0.0",
  "description": "一个用于 Git 操作的 MCP 服务器",
  "main": "dist/index.js",
  "bin": {
    "git-mcp-server": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "api": "node --loader ts-node/esm api/index.ts",
    "web": "cd web && npm run dev",
    "dev:all": "concurrently \"npm run api\" \"npm run web\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "git",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "zod": "^4.1.13",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2",
    "concurrently": "^8.2.2"
  }
}
